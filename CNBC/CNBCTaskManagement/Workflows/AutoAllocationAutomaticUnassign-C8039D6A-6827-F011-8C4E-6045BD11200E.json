              "fetchXml": "<fetch>\n  <entity name=\"tsk_userstatus\">\n    <attribute name=\"tsk_user\" />\n    <attribute name=\"tsk_userstatusid\" />\n    <filter>\n      <condition attribute=\"tsk_isonline\" operator=\"eq\" value=\"0\" />\n      <condition attribute=\"tsk_unallocatecompleted\" operator=\"eq\" value=\"0\" />\n      <condition attribute=\"tsk_lastoffline\" operator=\"olderthan-x-minutes\" value=\"@{parameters('Auto Allocation Delay Length Before Unassign (tsk_AutoAllocationDelayLengthBeforeUnassign)')}\" />\n    </filter>\n  </entity>\n</fetch>\n"
