                ]
              },
              "metadata": {
                "operationMetadataId": "f1fbd256-bf36-4c8b-8ff2-8a5117d4bb54"
              }
            },
            "Compose_|_Placeholder_for_error_logging": {
              "type": "Compose",
              "inputs": "placeholder",
              "metadata": {
                "operationMetadataId": "f59386d7-11a4-41ce-b82b-057ed816894a"
              }
            },
            "Respond_to_a_Power_App_or_flow_|_Return_original_text": {
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "processedtext": {
                      "title": "ProcessedText",
                      "x-ms-dynamically-added": true,
                      "type": "string"
                    }
                  },
                  "additionalProperties": {}
                },
                "statusCode": 200,
                "body": {
                  "processedtext": "@triggerBody()['text']"
                }
              },
              "runAfter": {
                "Compose_|_Placeholder_for_error_logging": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "5524eda3-46de-4b30-922e-8ecb300f0d57"
              }
            }
          },
          "runAfter": {
            "Scope_|_Try_Process_Email_Body": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "b46056da-1a04-4cbd-bbb3-241786aa2a86"
          }
        },
        "Initialize_variable_|_ModifiedText_as_EmailBody": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "ModifiedText",
                "type": "string",
                "value": "@triggerBody()['text']"
              }
            ]
          },
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "2ab8cf88-d683-4c9f-af68-026fb31752e3"
