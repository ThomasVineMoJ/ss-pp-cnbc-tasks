                }
              },
              "runAfter": {
                "Scope_|_Remove_newline_character_and_limit_length_of_returned_string": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "4b198bf4-91b2-4f23-9d8d-9411523d6097"
              }
            }
          },
          "runAfter": {
            "Initialize_variable_|_HasFinished_as_FALSE": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "ba1480dd-8fbc-4b53-86c5-15fdf0476037"
          }
        },
        "Scope_|_Catch_All_Errors": {
          "type": "Scope",
          "actions": {
            "Terminate_|_Failed": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "800",
                  "message": "An unhandled error has occured"
                }
              },
              "runAfter": {
                "Respond_to_a_Power_App_or_flow_|_Return_original_text": [
